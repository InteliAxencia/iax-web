---
import { MAXIMOS, type Opcion } from "../lib/formularios";

interface Props {
  id: string;
  nombre: string;
  etiqueta?: string;
  tipo?:
    "text" | "email" | "checkbox" | "tel" | "textarea" | "radio" | "casillas";
  autocomplete?: string;
  requerido?: boolean;
  placeholder?: string;
  pattern?: string;
  maxlength?: number;
  opciones?: readonly Opcion[];
}

const {
  id,
  nombre,
  etiqueta,
  tipo = "text",
  autocomplete,
  requerido = false,
  placeholder,
  pattern,
  maxlength,
  opciones = [],
} = Astro.props;

const idEstado = `${id}-estado`;
const esCasilla = tipo === "checkbox";
const esTextarea = tipo === "textarea";
const esGrupo = tipo === "radio" || tipo === "casillas";
const tipoControl = tipo === "casillas" ? "checkbox" : "radio";
---

<div class="campo">
  {
    esCasilla ? (
      <label class="campo-casilla texto-con-enlaces" for={id}>
        <input
          type="checkbox"
          id={id}
          name={nombre}
          required={requerido}
          aria-describedby={idEstado}
        />
        <span>
          <slot />
        </span>
      </label>
    ) : esGrupo ? (
      <fieldset
        class="campo-grupo"
        data-requerido={tipo === "casillas" && requerido ? "" : undefined}
      >
        <legend class="campo-etiqueta">
          {etiqueta}{" "}
          {tipo === "casillas" && (
            <span class="campo-ayuda">(puedes marcar varias)</span>
          )}
        </legend>
        {opciones.map((opcion) => (
          <div class="campo-opcion">
            <label class="campo-casilla">
              <input
                type={tipoControl}
                name={nombre}
                value={opcion.valor}
                required={tipo === "radio" && requerido}
                aria-describedby={idEstado}
              />
              <span>{opcion.texto}</span>
            </label>
            {opcion.otro && (
              <input
                type="text"
                class="campo-otro"
                name={`${nombre}-otro`}
                maxlength={MAXIMOS.otro}
                aria-label="Especifica otro"
                aria-describedby={idEstado}
              />
            )}
          </div>
        ))}
      </fieldset>
    ) : esTextarea ? (
      <>
        <label class="campo-etiqueta" for={id}>
          {etiqueta}
        </label>
        <textarea
          id={id}
          name={nombre}
          maxlength={maxlength}
          placeholder={placeholder}
          required={requerido}
          aria-describedby={idEstado}
        />
      </>
    ) : (
      <>
        <label class="campo-etiqueta" for={id}>
          {etiqueta}
        </label>
        <input
          type={tipo}
          id={id}
          name={nombre}
          autocomplete={autocomplete}
          pattern={pattern}
          maxlength={maxlength}
          placeholder={placeholder}
          required={requerido}
          aria-describedby={idEstado}
        />
      </>
    )
  }
  <p class="campo-estado" id={idEstado} role="status"></p>
</div>

<style>
  .campo {
    margin-bottom: 16px;
  }

  .campo-etiqueta {
    display: block;
    font-weight: 500;
    font-size: 0.88rem;
    margin-bottom: 6px;
  }

  .campo input:not([type="checkbox"], [type="radio"]),
  .campo textarea {
    width: 100%;
    font-family: var(--font-sans);
    font-size: 1rem;
    padding: 12px 14px;
    border: 1.5px solid var(--color-borde);
    border-radius: 10px;
    background: var(--color-blanco);
    color: var(--color-negro);
  }

  .campo input:not([type="checkbox"], [type="radio"]):focus-visible,
  .campo textarea:focus-visible {
    border-color: var(--color-indigo);
  }

  .campo textarea {
    min-height: 110px;
    resize: vertical;
    line-height: 1.5;
  }

  .campo-casilla {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.9rem;
    color: var(--color-texto-suave);
  }

  .campo-casilla input {
    margin-top: 4px;
    flex-shrink: 0;
    accent-color: var(--color-indigo);
  }

  .campo-grupo .campo-etiqueta {
    margin-bottom: 10px;
  }

  .campo-ayuda {
    font-weight: 300;
    color: var(--color-texto-suave);
  }

  .campo-opcion + .campo-opcion {
    margin-top: 8px;
  }

  .campo-otro {
    margin-top: 8px;
  }

  /* El campo de «Otro» solo se ve con su opción marcada, sin JavaScript.
     Sin soporte de :has(), queda siempre visible. */
  .campo-opcion:has(.campo-casilla input:not(:checked)) .campo-otro {
    display: none;
  }

  .campo-estado {
    margin-top: 6px;
    font-size: 0.88rem;
    color: var(--color-error);
  }

  .campo-estado:empty {
    display: none;
  }

  @media (min-width: 821px) {
    .campo-etiqueta {
      font-size: 1rem;
    }

    .campo-casilla {
      font-size: 1.05rem;
    }

    .campo-casilla input {
      width: 1.1em;
      height: 1.1em;
      margin-top: 0.2em;
    }
  }
</style>
