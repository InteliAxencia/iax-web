---
import Campo from "./Campo.astro";
---

<section class="contacto" id="contacto">
  <div class="wrap grid">
    <div class="section-head">
      <span class="eyebrow">Siguiente paso</span>
      <h2>Empecemos por tu problema</h2>
      <p>No necesitas tener definida la herramienta ni la solución.</p>
      <p>
        Cuéntanos qué quieres mejorar, qué tarea te lleva demasiado tiempo o qué
        dificultad encuentras en tu forma actual de trabajar.
      </p>
      <p>Analizamos tu situación y vemos juntos si podemos ayudarte.</p>
    </div>
    <div class="card-form">
      <!-- Con JavaScript, el script envía a /api/contacto con fetch. Sin él,
           el navegador hace el POST a la misma ruta y muestra la respuesta
           JSON; los datos nunca van en la URL. El respaldo con redirección a
           páginas estáticas queda como mejora anotada. -->
      <form id="form-contacto" method="post" action="/api/contacto" novalidate>
        <Campo
          id="contacto-nombre"
          nombre="nombre"
          etiqueta="Nombre y apellidos"
          tipo="text"
          autocomplete="name"
          requerido
        />
        <Campo
          id="contacto-email"
          nombre="email"
          etiqueta="Correo electrónico"
          tipo="email"
          autocomplete="email"
          placeholder="tu@email.com"
          pattern="^[^@\s]+@[^@\s]+\.[^@\s]+$"
          requerido
        />
        <Campo
          id="contacto-telefono"
          nombre="telefono"
          etiqueta="Teléfono (opcional)"
          tipo="tel"
          autocomplete="tel"
        />
        <Campo
          id="contacto-mensaje"
          nombre="mensaje"
          etiqueta="Mensaje"
          tipo="textarea"
          requerido
        />
        <div class="trampa" aria-hidden="true">
          <label for="contacto-web">No rellenes este campo</label>
          <input
            id="contacto-web"
            name="web"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>
        <p class="contacto-info texto-con-enlaces">
          Usaremos tus datos solo para responder a tu consulta. Más información
          y cómo ejercer tus derechos en la <a href="/privacidad"
            >política de privacidad</a
          >. No incluyas datos de tus clientes ni información confidencial.
        </p>
        <button class="btn btn-indigo" type="submit">Enviar</button>
        <p class="contacto-ok" id="contacto-ok" role="status"></p>
      </form>
    </div>
  </div>
</section>

<script>
  const formulario = document.querySelector<HTMLFormElement>("#form-contacto");
  const confirmacion = document.querySelector<HTMLElement>("#contacto-ok");
  const boton = formulario?.querySelector<HTMLButtonElement>(
    'button[type="submit"]',
  );

  const TEXTO_BOTON = "Enviar";
  const TEXTO_ENVIANDO = "Enviando…";
  const TEXTO_OK =
    "Gracias por escribirnos. Te responderemos en un máximo de dos días laborables.";
  const TEXTO_ERROR =
    "No hemos podido enviar tu mensaje. Inténtalo de nuevo en unos minutos o escríbenos a info@inteliaxencia.com.";

  function mensajeError(
    control: HTMLInputElement | HTMLTextAreaElement,
  ): string {
    if (control.validity.valueMissing) {
      return control.tagName === "TEXTAREA"
        ? "Error: cuéntanos qué necesitas para poder ayudarte."
        : "Error: este campo es obligatorio.";
    }
    return "Error: introduce un correo válido, por ejemplo tu@email.com.";
  }

  if (formulario && confirmacion && boton) {
    formulario.addEventListener("submit", async (evento) => {
      evento.preventDefault();
      if (boton.disabled) return;

      let primerError: HTMLInputElement | HTMLTextAreaElement | null = null;

      for (const control of formulario.querySelectorAll<
        HTMLInputElement | HTMLTextAreaElement
      >("input, textarea")) {
        const estado = document.getElementById(`${control.id}-estado`);
        if (estado) estado.textContent = "";
        control.removeAttribute("aria-invalid");

        if (!control.checkValidity()) {
          if (estado) estado.textContent = mensajeError(control);
          control.setAttribute("aria-invalid", "true");
          primerError ??= control;
        }
      }

      if (primerError) {
        primerError.focus();
        return;
      }

      // El FormData se toma antes de desactivar nada: los campos desactivados
      // no se envían.
      const datos = new FormData(formulario);
      confirmacion.textContent = "";
      confirmacion.classList.remove("contacto-ok--error");
      boton.disabled = true;
      boton.textContent = TEXTO_ENVIANDO;

      let enviado = false;
      try {
        const respuesta = await fetch("/api/contacto", {
          method: "POST",
          body: datos,
        });
        enviado = respuesta.ok;
      } catch {
        // Sin conexión o la petición no llegó: se muestra el error.
      }

      boton.textContent = TEXTO_BOTON;

      if (enviado) {
        confirmacion.textContent = TEXTO_OK;
        for (const el of formulario.querySelectorAll<HTMLElement>(
          "input, textarea, button",
        )) {
          el.setAttribute("disabled", "");
        }
        return;
      }

      confirmacion.classList.add("contacto-ok--error");
      confirmacion.textContent = TEXTO_ERROR;
      boton.disabled = false;
    });
  }
</script>

<style>
  .contacto .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    align-items: start;
  }

  .card-form {
    background: var(--color-blanco);
    border: 1px solid var(--color-borde);
    border-radius: var(--radius);
    padding: 26px 20px;
    box-shadow: 0 8px 30px rgba(27, 15, 150, 0.07);
  }

  .contacto-info {
    margin-bottom: 16px;
    font-size: 0.85rem;
    color: var(--color-texto-suave);
  }

  .contacto-ok {
    margin-top: 14px;
    padding: 14px 16px;
    border: 1px solid var(--color-ok-borde);
    border-radius: 10px;
    background: var(--color-ok-fondo);
    color: var(--color-ok-texto);
    font-size: 0.95rem;
  }

  .contacto-ok:empty {
    display: none;
  }

  .contacto-ok--error {
    border-color: var(--color-error);
    background: var(--color-blanco);
    color: var(--color-error);
  }

  @media (min-width: 821px) {
    .contacto .grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 56px;
    }

    .card-form {
      padding: 32px;
    }
  }
</style>
