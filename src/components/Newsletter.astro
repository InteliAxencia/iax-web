---
import Campo from "./Campo.astro";
import { PATRON_CORREO } from "../lib/correo";
---

<section class="newsletter" id="newsletter">
  <div class="wrap">
    <div class="newsletter-inner">
      <div class="newsletter-texto">
        <span class="eyebrow">Newsletter</span>
        <h2>IA y derecho laboral, sin ruido</h2>
        <p>
          Una vez al mes: novedades de IA relevantes para el ámbito laboral,
          casos prácticos y herramientas explicadas en claro. Sin spam.
        </p>
      </div>
      <div>
        <!-- Con JavaScript, el formulario se envía con fetch y el resultado se
             muestra aquí. Sin él, el POST va a /api/boletin, que responde solo
             { ok } en JSON (decisión 44). El esquema está en
             src/lib/boletin.ts. -->
        <form
          id="form-newsletter"
          method="post"
          action="/api/boletin"
          novalidate
        >
          <Campo
            id="news-email"
            nombre="email"
            etiqueta="Correo electrónico"
            tipo="email"
            autocomplete="email"
            placeholder="tu@email.com"
            pattern={PATRON_CORREO}
            requerido
          />
          <!-- PROVISIONAL hasta constituir la S.L.: entonces se revisa este
               texto junto con la política de privacidad. -->
          <Campo
            id="news-consentimiento"
            nombre="consentimiento"
            tipo="checkbox"
            requerido
          >
            Acepto recibir el boletín mensual de inteliAxencia en mi correo
            electrónico y he leído la <a href="/privacidad"
              >política de privacidad</a
            >. Puedo darme de baja en cualquier momento.
          </Campo>
          <div class="trampa" aria-hidden="true">
            <label for="news-web">No rellenes este campo</label>
            <input
              id="news-web"
              name="web"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>
          <button class="btn btn-indigo" type="submit">Suscribirme</button>
          <p class="newsletter-ok" id="news-ok" role="status"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const formulario =
    document.querySelector<HTMLFormElement>("#form-newsletter");
  const confirmacion = document.querySelector<HTMLElement>("#news-ok");
  const boton = formulario?.querySelector<HTMLButtonElement>(
    'button[type="submit"]',
  );

  const TEXTO_BOTON = "Suscribirme";
  const TEXTO_ENVIANDO = "Enviando…";
  const TEXTO_OK =
    "Revisa tu bandeja: te hemos enviado un correo para confirmar la suscripción.";
  const TEXTO_ERROR =
    "No hemos podido completar tu suscripción. Inténtalo de nuevo en unos minutos o escríbenos a info@inteliaxencia.com.";
  const TEXTO_REVISA =
    "No hemos podido completar tu suscripción. Revisa los datos e inténtalo de nuevo.";

  function mensajeError(control: HTMLInputElement): string {
    if (control.type === "checkbox") {
      return "Error: marca la casilla para poder suscribirte.";
    }
    if (control.validity.valueMissing) {
      return "Error: escribe tu correo para que podamos enviarte la newsletter.";
    }
    return "Error: introduce un correo válido, por ejemplo tu@email.com.";
  }

  if (formulario && confirmacion && boton) {
    formulario.addEventListener("submit", async (evento) => {
      evento.preventDefault();
      if (boton.disabled) return;

      let primerError: HTMLInputElement | null = null;

      for (const control of formulario.querySelectorAll<HTMLInputElement>(
        "input",
      )) {
        const estado = document.getElementById(`${control.id}-estado`);
        if (estado) estado.textContent = "";
        control.removeAttribute("aria-invalid");

        if (!control.checkValidity()) {
          if (estado) estado.textContent = mensajeError(control);
          control.setAttribute("aria-invalid", "true");
          primerError ??= control;
        }
      }

      if (primerError) {
        primerError.focus();
        return;
      }

      // El FormData se toma antes de desactivar nada: los campos desactivados
      // no se envían.
      const datos = new FormData(formulario);
      confirmacion.textContent = "";
      confirmacion.classList.remove("newsletter-ok--error");
      boton.disabled = true;
      boton.textContent = TEXTO_ENVIANDO;

      let enviado = false;
      let estado = 0;
      try {
        const respuesta = await fetch("/api/boletin", {
          method: "POST",
          body: datos,
        });
        enviado = respuesta.ok;
        estado = respuesta.status;
      } catch {
        // Sin conexión o la petición no llegó: se muestra el error.
      }

      boton.textContent = TEXTO_BOTON;

      if (enviado) {
        confirmacion.textContent = TEXTO_OK;
        for (const el of formulario.querySelectorAll<HTMLElement>(
          "input, button",
        )) {
          el.setAttribute("disabled", "");
        }
        return;
      }

      confirmacion.classList.add("newsletter-ok--error");
      confirmacion.textContent =
        estado === 400 || estado === 413 ? TEXTO_REVISA : TEXTO_ERROR;
      boton.disabled = false;
    });
  }
</script>

<style>
  .newsletter {
    background: var(--color-gris-claro);
  }

  .newsletter-inner {
    background: var(--color-blanco);
    border: 1px solid var(--color-borde);
    border-radius: var(--radius);
    padding: 32px 24px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
  }

  .newsletter-texto h2 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }

  .newsletter-texto p {
    margin-top: 12px;
    color: var(--color-texto-suave);
  }

  .newsletter-ok {
    margin-top: 14px;
    padding: 14px 16px;
    border: 1px solid var(--color-ok-borde);
    border-radius: 10px;
    background: var(--color-ok-fondo);
    color: var(--color-ok-texto);
    font-size: 0.95rem;
  }

  .newsletter-ok:empty {
    display: none;
  }

  .newsletter-ok--error {
    border-color: var(--color-error);
    background: var(--color-blanco);
    color: var(--color-error);
  }

  @media (min-width: 821px) {
    .newsletter-inner {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 44px;
      padding: 52px;
    }
  }
</style>
