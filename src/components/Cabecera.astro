---
const enlaces = [
  { href: "#servicios", texto: "Servicios" },
  { href: "#metodo", texto: "Método" },
  { href: "#ia-local", texto: "IA local" },
  { href: "#equipo", texto: "Equipo" },
];
---

<header>
  <div class="wrap nav">
    <a class="logo" href="#inicio" aria-label="iAx inteliAxencia, inicio"
      >iA<span class="x">x</span></a
    >
    <details class="nav-menu">
      <summary aria-label="Menú"><span aria-hidden="true">☰</span></summary>
    </details>
    <ul class="nav-links">
      {
        enlaces.map((e) => (
          <li>
            <a href={e.href}>{e.texto}</a>
          </li>
        ))
      }
      <li>
        <a class="btn btn-indigo" href="#contacto">Hablemos de tu caso</a>
      </li>
    </ul>
  </div>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .nav .logo {
    color: var(--color-indigo);
  }

  .nav-menu summary {
    display: block;
    list-style: none;
    font-size: 1.7rem;
    color: var(--color-indigo);
    cursor: pointer;
    line-height: 1;
    padding: 8px;
  }

  .nav-menu summary::-webkit-details-marker {
    display: none;
  }

  .nav-links {
    list-style: none;
    position: absolute;
    top: 64px;
    left: 0;
    right: 0;
    background: var(--color-blanco);
    display: none;
    flex-direction: column;
    gap: 0;
    border-bottom: 1px solid var(--color-borde);
    padding: 8px 0 18px;
  }

  /* El ul es hermano del details, no su hijo: un details cerrado no pinta
     a sus descendientes. La apertura se lee con el combinador de hermano. */
  .nav-menu[open] ~ .nav-links {
    display: flex;
  }

  .nav-links li {
    width: 100%;
    text-align: center;
    padding: 10px 0;
  }

  .nav-links a {
    font-weight: 500;
    font-size: 1rem;
    text-decoration: none;
    color: #111;
  }

  .nav-links a:hover {
    color: var(--color-indigo);
  }

  /* Ganan a .nav-links a y a su hover, que antes pisaban el color del CTA
     y dejaban texto negro o indigo sobre fondo indigo. */
  .nav-links a.btn-indigo {
    color: var(--color-blanco);
    padding: 12px 24px;
    font-size: 0.95rem;
  }

  .nav-links a.btn-indigo:hover {
    color: var(--color-blanco);
    background: var(--color-indigo-deep);
  }

  @media (min-width: 821px) {
    .nav {
      height: 72px;
    }

    .nav-menu {
      display: contents;
    }

    .nav-menu summary {
      display: none;
    }

    .nav-links {
      display: flex;
      position: static;
      flex-direction: row;
      align-items: center;
      gap: 24px;
      border: none;
      padding: 0;
      background: transparent;
    }

    .nav-links li {
      width: auto;
      padding: 0;
    }

    .nav-links a {
      font-size: 0.95rem;
    }

    .nav-links a.btn-indigo {
      padding: 10px 22px;
      font-size: 0.9rem;
    }
  }
</style>
