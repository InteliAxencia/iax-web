---
import Campo from "./Campo.astro";
import { PATRON_CORREO } from "../lib/correo";
import {
  AVISO_CAMPO_ABIERTO,
  ENUNCIADO_CONTACTO,
  EQUIPO,
  FORMULARIOS,
  HORARIO,
  MAXIMOS,
  PERFIL,
  type TipoFormulario,
} from "../lib/formularios";

interface Props {
  tipo: TipoFormulario;
}

const f = FORMULARIOS[Astro.props.tipo];
const opcional = (texto: string) => `${texto} (opcional)`;
---

<section class="consulta">
  <div class="wrap">
    <div class="consulta-lectura">
      <h1>{f.titulo}</h1>
      <p class="consulta-intro">{f.intro}</p>
      {
        /* Con JavaScript, el script envía a /api/consulta con fetch. Sin él,
           el navegador hace el POST a la misma ruta y muestra la respuesta
           JSON; los datos nunca van en la URL. */
      }
      <form
        class="consulta-form"
        id="form-consulta"
        method="post"
        action="/api/consulta"
        novalidate
      >
        <input type="hidden" name="tipo" value={f.tipo} />
        <Campo
          id="consulta-perfil"
          nombre={PERFIL.nombre}
          etiqueta={opcional(PERFIL.enunciado)}
          tipo="radio"
          opciones={PERFIL.opciones}
        />
        <Campo
          id="consulta-equipo"
          nombre={EQUIPO.nombre}
          etiqueta={opcional(EQUIPO.enunciado)}
          tipo="radio"
          opciones={EQUIPO.opciones}
        />
        <Campo
          id="consulta-necesidad"
          nombre={f.necesidad.nombre}
          etiqueta={f.necesidad.enunciado}
          tipo="casillas"
          opciones={f.necesidad.opciones}
          requerido
        />
        {
          f.experiencia && (
            <Campo
              id="consulta-experiencia"
              nombre={f.experiencia.nombre}
              etiqueta={f.experiencia.enunciado}
              tipo="radio"
              opciones={f.experiencia.opciones}
              requerido
            />
          )
        }
        <Campo
          id="consulta-contexto"
          nombre="contexto"
          etiqueta={opcional(f.contexto)}
          tipo="textarea"
          maxlength={MAXIMOS.contexto}
          ayuda={AVISO_CAMPO_ABIERTO}
        />
        <fieldset class="consulta-contacto">
          <legend class="consulta-pregunta">{ENUNCIADO_CONTACTO}</legend>
          <Campo
            id="consulta-nombre"
            nombre="nombre"
            etiqueta="Nombre y apellidos"
            tipo="text"
            autocomplete="name"
            maxlength={MAXIMOS.nombre}
            requerido
          />
          <Campo
            id="consulta-email"
            nombre="email"
            etiqueta="Correo electrónico"
            tipo="email"
            autocomplete="email"
            placeholder="tu@email.com"
            pattern={PATRON_CORREO}
            requerido
          />
          <div class="consulta-telefono">
            <Campo
              id="consulta-prefijo"
              nombre="prefijo"
              etiqueta="Prefijo"
              tipo="tel"
              autocomplete="tel-country-code"
              placeholder="Ej: +34"
              pattern="\+?[0-9]{1,3}"
              maxlength={4}
            />
            <Campo
              id="consulta-telefono"
              nombre="telefono"
              etiqueta="Teléfono (opcional)"
              tipo="tel"
              autocomplete="tel-national"
              pattern=" *(?:[0-9] *){8,15}"
              maxlength={30}
            />
          </div>
          <Campo
            id="consulta-organizacion"
            nombre="organizacion"
            etiqueta="Despacho u organización (opcional)"
            tipo="text"
            autocomplete="organization"
            maxlength={MAXIMOS.organizacion}
          />
          <Campo
            id="consulta-horario"
            nombre={HORARIO.nombre}
            etiqueta={opcional(HORARIO.enunciado)}
            tipo="casillas"
            opciones={HORARIO.opciones}
          />
        </fieldset>
        <div class="trampa" aria-hidden="true">
          <label for="consulta-web">No rellenes este campo</label>
          <input
            id="consulta-web"
            name="web"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>
        <button class="btn btn-indigo" type="submit">Enviar</button>
        <p class="consulta-ok" id="consulta-ok" role="status"></p>
        <p class="consulta-nota" id="consulta-plazo">
          Te responderemos en un máximo de dos días laborables.
        </p>
        {
          /* Se revisa al constituir la S.L., junto con la política de
             privacidad. */
        }
        <p class="consulta-nota texto-con-enlaces">
          Usaremos tus datos solo para responder a tu consulta. Más información
          y cómo ejercer tus derechos en la <a href="/privacidad"
            >política de privacidad</a
          >. No incluyas datos de tus clientes ni información confidencial.
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  type Control = HTMLInputElement | HTMLTextAreaElement;

  const formulario = document.querySelector<HTMLFormElement>("#form-consulta");
  const confirmacion = document.querySelector<HTMLElement>("#consulta-ok");
  const plazo = document.querySelector<HTMLElement>("#consulta-plazo");
  const boton = formulario?.querySelector<HTMLButtonElement>(
    'button[type="submit"]',
  );

  // Tiempo máximo de espera del envío: más que los 10 segundos que el servidor
  // espera a Mailjet, para no cortar una respuesta lenta pero válida.
  const TIEMPO_MAXIMO_MS = 20_000;

  const TEXTO_BOTON = "Enviar";
  const TEXTO_ENVIANDO = "Enviando…";
  const TEXTO_OK =
    "Gracias por escribirnos. Te responderemos en un máximo de dos días laborables.";
  const TEXTO_ERROR =
    "No hemos podido enviar tu mensaje. Inténtalo de nuevo en unos minutos o escríbenos a info@inteliaxencia.com.";
  const TEXTO_REVISA =
    "No hemos podido enviar tu mensaje. Revisa los datos e inténtalo de nuevo.";

  function mensajeError(control: Control): string {
    if (control.name === "prefijo") return "Error: revisa el prefijo.";
    if (control.name === "telefono") {
      return "Error: escribe un teléfono de entre 8 y 15 cifras. Solo están permitidos números y espacios.";
    }
    if (control.type === "radio") return "Error: elige una opción.";
    if (control.validity.valueMissing) {
      return "Error: este campo es obligatorio.";
    }
    return "Error: introduce un correo válido, por ejemplo tu@email.com.";
  }

  if (formulario && confirmacion && boton) {
    formulario.addEventListener("submit", async (evento) => {
      evento.preventDefault();
      if (boton.disabled) return;

      // El prefijo es obligatorio solo si se escribe teléfono.
      const campoPrefijo =
        formulario.querySelector<HTMLInputElement>('[name="prefijo"]');
      const campoTelefono =
        formulario.querySelector<HTMLInputElement>('[name="telefono"]');
      if (campoPrefijo && campoTelefono)
        campoPrefijo.required = campoTelefono.value.trim() !== "";

      let primerError: Control | null = null;

      // Cada .campo es una pregunta: un control, o un grupo de opciones con
      // un único mensaje de estado.
      for (const campo of formulario.querySelectorAll<HTMLElement>(".campo")) {
        const estado = campo.querySelector<HTMLElement>(".campo-estado");
        const controles = [
          ...campo.querySelectorAll<Control>("input, textarea"),
        ];
        for (const control of controles)
          control.removeAttribute("aria-invalid");

        let erroneo = controles.find((control) => !control.checkValidity());
        let mensaje = erroneo ? mensajeError(erroneo) : "";

        // HTML no sabe exigir «al menos una casilla»: se comprueba aquí y en
        // el servidor.
        const sinMarcar =
          campo.querySelector("fieldset[data-requerido]") &&
          !campo.querySelector('input[type="checkbox"]:checked');
        if (!erroneo && sinMarcar) {
          erroneo = controles[0];
          mensaje = "Error: marca al menos una opción.";
        }

        if (estado) estado.textContent = mensaje;
        if (erroneo) {
          erroneo.setAttribute("aria-invalid", "true");
          primerError ??= erroneo;
        }
      }

      if (primerError) {
        primerError.focus();
        return;
      }

      // El FormData se toma antes de desactivar nada: los campos desactivados
      // no se envían.
      const datos = new FormData(formulario);
      confirmacion.textContent = "";
      confirmacion.classList.remove("consulta-ok--error");
      boton.disabled = true;
      boton.textContent = TEXTO_ENVIANDO;

      let enviado = false;
      let estado = 0;
      try {
        const respuesta = await fetch("/api/consulta", {
          method: "POST",
          body: datos,
          signal: AbortSignal.timeout(TIEMPO_MAXIMO_MS),
        });
        enviado = respuesta.ok;
        estado = respuesta.status;
      } catch {
        // Sin conexión, la petición no llegó o se agotó el tiempo máximo: se
        // muestra el error.
      }

      boton.textContent = TEXTO_BOTON;

      if (enviado) {
        confirmacion.textContent = TEXTO_OK;
        // El mensaje ya da el plazo: la nota fija lo repetiría.
        if (plazo) plazo.hidden = true;
        for (const el of formulario.querySelectorAll<HTMLElement>(
          "input, textarea, button",
        )) {
          el.setAttribute("disabled", "");
        }
        return;
      }

      confirmacion.classList.add("consulta-ok--error");
      confirmacion.textContent =
        estado === 400 || estado === 413 ? TEXTO_REVISA : TEXTO_ERROR;
      boton.disabled = false;
    });
  }
</script>

<style>
  .consulta-lectura {
    max-width: var(--max-w-lectura);
    margin-inline: auto;
  }

  /* Mismo tamaño y color que el h1 de «Conoce al equipo». */
  .consulta-lectura h1 {
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    color: var(--color-indigo);
  }

  .consulta-intro {
    margin-top: 16px;
    margin-bottom: 36px;
    color: var(--color-texto-suave);
  }

  /* Separación entre preguntas. Va con :global() porque .campo es la raíz de
     otro componente y lleva su identificador de ámbito, no el de este. */
  .consulta-form > :global(.campo),
  .consulta-contacto {
    margin-bottom: 32px;
  }

  .consulta-pregunta {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-indigo);
    margin-bottom: 16px;
  }

  .consulta-telefono {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 12px;
  }

  .consulta-nota {
    margin-top: 14px;
    font-size: 0.85rem;
    color: var(--color-texto-suave);
  }

  .consulta-ok {
    margin-top: 14px;
    padding: 14px 16px;
    border: 1px solid var(--color-ok-borde);
    border-radius: 10px;
    background: var(--color-ok-fondo);
    color: var(--color-ok-texto);
    font-size: 0.95rem;
  }

  .consulta-ok:empty {
    display: none;
  }

  .consulta-ok--error {
    border-color: var(--color-error);
    background: var(--color-blanco);
    color: var(--color-error);
  }
</style>
