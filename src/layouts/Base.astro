---
import "../styles/global.css";

interface Props {
  titulo?: string;
  descripcion?: string;
  sinIndexar?: boolean;
}

const {
  titulo = "inteliAxencia · IA y automatización para despachos laborales",
  descripcion = "Analizamos cómo trabaja tu despacho laboral, formamos a tu equipo e implementamos IA adaptada, también en local para controlar tu información.",
  sinIndexar = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {sinIndexar && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {
      /* Excepcion a la regla de tokens: un meta no puede leer var(), asi que
         el indigo va escrito a mano. Es el valor de --color-indigo en
         global.css. Si cambia, hay que cambiarlo aqui y en theme_color y
         background_color de public/site.webmanifest. */
    }
    <meta name="theme-color" content="#1B0F96" />
  </head>
  <body>
    <slot />
  </body>
</html>
