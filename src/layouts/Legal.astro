---
import Base from "./Base.astro";
import Cabecera from "../components/Cabecera.astro";
import Pie from "../components/Pie.astro";

interface Props {
  titulo: string;
  descripcion: string;
  sinIndexar?: boolean;
}

const { titulo, descripcion, sinIndexar } = Astro.props;
---

<Base titulo={titulo} descripcion={descripcion} sinIndexar={sinIndexar}>
  <Cabecera />
  <main class="lectura texto-con-enlaces">
    <slot />
  </main>
  <Pie />
</Base>

<style>
  /* Texto corrido. El preflight de Tailwind quita márgenes de párrafo,
     viñetas de lista y estilo de enlace, así que aquí no se decora: se
     devuelve lo que el documento necesita para leerse.

     Va con :global() porque el marcado lo escribe la página y recibe su
     propio identificador de ámbito, no el del layout. Todo cuelga de
     .lectura para que no se escape al resto del sitio. */

  .lectura {
    max-width: var(--max-w-lectura);
    margin: 0 auto;
    padding: 56px var(--gutter) 72px;
  }

  .lectura :global(h1) {
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    color: var(--color-indigo);
    margin-bottom: 8px;
  }

  .lectura :global(h2) {
    font-size: 1.3rem;
    margin-top: 40px;
    margin-bottom: 12px;
  }

  .lectura :global(h3) {
    font-size: 1.05rem;
    margin-top: 28px;
    margin-bottom: 8px;
  }

  .lectura :global(p) {
    margin-bottom: 16px;
    color: var(--color-texto-suave);
  }

  /* La línea de fecha lleva su propio estilo: una clase de global.css perdería
     el color frente a la regla de arriba, que compila con el atributo de ámbito
     del layout y tiene más especificidad. */

  .lectura :global(p.actualizado) {
    color: var(--color-gris);
    font-size: 0.85rem;
    font-weight: 300;
    margin-bottom: 32px;
  }

  .lectura :global(ul) {
    list-style: disc;
    padding-left: 22px;
    margin-bottom: 16px;
  }

  .lectura :global(li) {
    margin-bottom: 8px;
    color: var(--color-texto-suave);
  }

  .lectura :global(strong) {
    font-weight: 700;
    color: var(--color-negro);
  }

  /* Tablas de las políticas. Cada una va dentro de un .tabla que la página
     marca con role="region", aria-label y tabindex="0": en móvil la tabla se
     desplaza en horizontal sin ensanchar la página, y el teclado alcanza
     ese desplazamiento. */

  .lectura :global(.tabla) {
    overflow-x: auto;
    margin-bottom: 24px;
  }

  .lectura :global(table) {
    width: 100%;
    min-width: 36rem;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .lectura :global(th),
  .lectura :global(td) {
    padding: 10px 12px;
    border: 1px solid var(--color-borde);
    text-align: left;
    vertical-align: top;
    color: var(--color-texto-suave);
  }

  .lectura :global(th) {
    background: var(--color-gris-claro);
    color: var(--color-negro);
    font-weight: 700;
  }

  @media (min-width: 821px) {
    .lectura {
      padding: 72px var(--gutter) 96px;
    }
  }
</style>
